# Copy to .env.local and fill in locally. NEVER commit a filled env file.
# Variable NAMES only — values live in your own Zetaris / Nightshift setup.

# Zetaris (team-run platform; the agent uses the run-query endpoint,
# same contract as the official getting-started client)
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
# Optional, for the official scripts / JDBC tooling:
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_USER_AGENT=whyline you@example.com

# Meterless Nightshift (Windows-edition daemon on the team's machine;
# NVIDIA Nemotron is connected inside Nightshift under Setup -> Providers)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=nvidia/nemotron-3-super-120b-a12b
